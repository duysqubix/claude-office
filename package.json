{
  "name": "claude-office",
  "version": "1.2.2",
  "private": true,
  "description": "A cosy little 3D office where your live Claude Code sessions are the employees and you're the manager.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts --open",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "snap": "node scripts/snap.mjs",
    "postinstall": "node scripts/fix-pty.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "smoke": "node scripts/smoke.mjs",
    "filmstrip": "node scripts/filmstrip.mjs",
    "catalog": "node scripts/catalog.mjs",
    "depth-fight": "node scripts/depth-fight.mjs",
    "hooks:install": "node scripts/hooks.mjs install",
    "hooks:uninstall": "node scripts/hooks.mjs uninstall",
    "hooks:status": "node scripts/hooks.mjs status",
    "statusline:install": "node scripts/statusline.mjs install",
    "statusline:uninstall": "node scripts/statusline.mjs uninstall",
    "statusline:status": "node scripts/statusline.mjs status"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "n8ao": "^2.0.1",
    "puppeteer-core": "^25.12.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
